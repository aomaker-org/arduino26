# ==============================================================================
# Path:        arduino_config.env
# Purpose:     Non-hidden, visible environment configuration file for Arduino26
# Target OS:   Ubuntu 24.04 / 26.04 LTS (WSL2) + Windows 11 Host
# Lineage:     Arduino26 Configuration Specification
# Updated:     2026-07-31
# ==============================================================================

# Target Microcontroller Board FQBN (Fully Qualified Board Name)
export ARDUINO_FQBN="arduino:avr:uno"

# Default Linux / WSL Serial Character Device
export ARDUINO_PORT_WSL="/dev/ttyUSB0"

# Default Windows Host COM Port
export ARDUINO_PORT_WIN="COM5"

# Primary Serial Baud Rate for Diagnostics & Telemetry
export ARDUINO_BAUD_DIAG="115200"

# Primary Serial Baud Rate for KY-015 / DHT11 Sensor
export ARDUINO_BAUD_DHT="9600"

# file arduino_config.env ends
