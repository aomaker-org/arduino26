# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit bash and script files
config_env text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ino text eol=lf
*.asm text eol=lf
*.rs text eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.ps1 text eol=crlf
