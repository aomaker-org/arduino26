import os
import sys
import glob
import subprocess
import hashlib
import argparse

VERSION = "2026.07.31-v1"
MAX_TRUNCATE_SIZE = 1024 * 1024   # 1MB safety gate per file
MAX_CLIPBOARD_BYTES = 250 * 1024  # 250 KB safety ceiling to prevent browser freezes

BINARY_EXTENSIONS = {
    '.exe', '.o', '.a', '.so', '.dylib', '.dll', '.bin', '.png', '.jpg', '.jpeg',
    '.gif', '.ico', '.pdf', '.tar', '.gz', '.xz', '.zip', '.7z', '.bz2',
    '.pyc', '.pyo', '.class', '.db', '.sqlite', '.sqlite3', '.hex', '.elf'
}

def is_binary_file(filepath):
    _, ext = os.path.splitext(filepath.lower())
    if ext in BINARY_EXTENSIONS:
        return True
    try:
        with open(filepath, 'rb') as f:
            chunk = f.read(1024)
            if b'\x00' in chunk:
                return True
    except Exception:
        pass
    return False

def get_tracked_files():
    """Parses git index to identify tracked assets."""
    try:
        cmd = ["git", "ls-files", "--cached"]
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return set(result.stdout.splitlines())
    except Exception:
        return None

def generate_file_stream(file_path):
    """Wraps target text asset contents into symmetrical, tail-scrolling blocks."""
    try:
        size = os.path.getsize(file_path)
        with open(file_path, 'r', errors='ignore') as f:
            content = f.read(MAX_TRUNCATE_SIZE)
        
        clean_content = content.replace('\r\n', '\n')
        sha256 = hashlib.sha256(clean_content.encode('utf-8')).hexdigest()
        
        header = f"--- BEGIN FILE: {file_path} | Size: {size} bytes | SHA256: {sha256} ---\n"
        footer = f"\n--- END FILE: {file_path} ---\n"
        return f"{header}{clean_content}{footer}"
    except Exception as e:
        return f"\n[!] Error generating stream node for {file_path}: {e}\n"

def resolve_targets(targets, include_untracked=False):
    """Resolves target paths, directories, and wildcards against Git or filesystem."""
    allowed_files = get_tracked_files() if not include_untracked else None
    resolved_files = []

    for target in targets:
        expanded_target = os.path.expanduser(target)
        globbed = glob.glob(expanded_target, recursive=True)
        
        if not globbed:
            if not os.path.exists(expanded_target):
                print(f"[!] Warning: Target '{target}' matched no files or paths.", file=sys.stderr)
            continue

        for path in globbed:
            norm_path = os.path.normpath(path).replace('\\', '/')
            
            if os.path.isdir(path):
                for root, dirs, files in os.walk(path):
                    dirs[:] = [d for d in dirs if d not in ('.git', 'archive', 'build', '.venv', '__pycache__')]
                    for file in files:
                        full_path = os.path.join(root, file)
                        rel_path = os.path.relpath(full_path, start=os.getcwd())
                        rel_norm = os.path.normpath(rel_path).replace('\\', '/')
                        
                        if include_untracked:
                            if not is_binary_file(full_path):
                                resolved_files.append(full_path)
                        else:
                            if allowed_files is None or rel_norm in allowed_files:
                                resolved_files.append(full_path)
            else:
                rel_path = os.path.relpath(path, start=os.getcwd())
                rel_norm = os.path.normpath(rel_path).replace('\\', '/')
                
                is_explicit_target = any(
                    os.path.normpath(os.path.expanduser(t)) == os.path.normpath(path) 
                    for t in targets
                )
                
                if include_untracked or is_explicit_target or (allowed_files is None) or (rel_norm in allowed_files) or (norm_path in allowed_files):
                    if not is_binary_file(path):
                        resolved_files.append(path)

    return list(dict.fromkeys(resolved_files))

def main():
    parser = argparse.ArgumentParser(
        description="Pack specific workspace targets into the system clipboard container."
    )
    parser.add_argument(
        "-v", "--version", action="version", version=f"files2clip {VERSION}",
        help="Show program version and exit."
    )
    parser.add_argument(
        "targets", nargs="*", default=["."],
        help="Target files, directories, or wildcard patterns"
    )
    parser.add_argument(
        "-a", "--all", "--everything", dest="everything", action="store_true",
        help="Perform raw filesystem traversal including untracked files."
    )
    
    args = parser.parse_args()
    files_to_pack = resolve_targets(args.targets, include_untracked=args.everything)
    
    if not files_to_pack:
        print("[X] Abort: No valid files identified for packing.", file=sys.stderr)
        sys.exit(1)
        
    output_nodes = [generate_file_stream(f) for f in files_to_pack]
    content = "".join(output_nodes)
    
    timestamp = subprocess.run(["date", "+%Y%m%d_%H%M%S"], capture_output=True, text=True).stdout.strip()
    wrapped_stream = (
        f"# Stream Frame: {timestamp}_Arduino26_Context_Payload | Generator: files2clip-{VERSION}\n"
        f"* **Target Scope Count:** {len(files_to_pack)} resolved files\n"
        f"-------------\n\n"
        f"{content}\n"
        f"-------------\n"
        f"# Tracking Footer: {timestamp}_Arduino26_Context_Payload_Complete\n"
    )
    
    payload_bytes = len(wrapped_stream.encode('utf-8', errors='ignore'))
    
    if payload_bytes > MAX_CLIPBOARD_BYTES:
        scratch_dir = os.path.join(os.getcwd(), "agy", "scratch")
        os.makedirs(scratch_dir, exist_ok=True)
        
        target_file = os.path.join(scratch_dir, f"bundle_{timestamp}.txt")
        try:
            with open(target_file, 'w', encoding='utf-8') as f:
                f.write(wrapped_stream)
            
            wrapped_stream = (
                f"=== CLIPBOARD OVERFLOW PROTECTION ===\n"
                f"Generator: files2clip-{VERSION}\n"
                f"Status: Safety Threshold Exceeded ({MAX_CLIPBOARD_BYTES / 1024:.1f} KB)\n"
                f"Total Target Assets Combined: {len(files_to_pack)}\n"
                f"Unpacked Payload Size: {payload_bytes / 1024:.2f} KB\n"
                f"Written to Storage: {os.path.abspath(target_file)}\n"
                f"=====================================\n"
            )
            print(f"[!] OVERFLOW WARNING: Payload size ({payload_bytes / 1024:.2f} KB) written to: {target_file}", file=sys.stderr)
        except Exception as e:
            print(f"[X] Write Error: Failed to archive overflow bundle: {e}", file=sys.stderr)
            sys.exit(1)

    copied = False
    wsl_clip = "/mnt/c/Windows/System32/clip.exe"
    if os.path.exists(wsl_clip):
        try:
            proc = subprocess.Popen([wsl_clip], stdin=subprocess.PIPE, text=True, errors='ignore')
            proc.communicate(input=wrapped_stream)
            if proc.returncode == 0:
                copied = True
        except Exception as e:
            pass

    if not copied:
        for cmd in [['clip.exe'], ['xclip', '-selection', 'clipboard'], ['wl-copy']]:
            try:
                proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, text=True, errors='ignore')
                proc.communicate(input=wrapped_stream)
                if proc.returncode == 0:
                    copied = True
                    break
            except Exception:
                continue

    if copied:
        print(f"[+] Bundle generated successfully ({len(files_to_pack)} assets). Pushed to clipboard.")
    else:
        print("[X] Error: Clipboard utility could not be reached.", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
